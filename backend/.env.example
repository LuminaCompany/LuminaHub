# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (secret — never expose to the client)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT secret used to verify Supabase auth tokens
# Found in Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin(s) allowed to make requests (comma-separated, no trailing slash)
FRONTEND_URL=http://localhost:3000,https://your-frontend.vercel.app
