# ─── Frontend (Next.js) — Vercel project: frontend ───────────────────────────
# NEXT_PUBLIC_* são embutidas no build → rebuild após alterar
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# URL pública do deploy do backend (NÃO usar localhost nem placeholder em prod)
# Ex: https://luminahub-backend.vercel.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ─── Backend (FastAPI) — Vercel project: backend ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Origem(ns) permitida(s) p/ CORS — domínio do frontend. Múltiplos: separar por vírgula
# Ex: https://luminahub.vercel.app
FRONTEND_URL=http://localhost:3000
